
{
  "manifest_version": 3,
  "name": "ReplayOS Recorder",
  "version": "0.1.0",
  "description": "Record selected browser interactions for debugging.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "ReplayOS Recorder",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
